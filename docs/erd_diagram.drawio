        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start([\&quot;Bắt đầu: Nhận yêu cầu Chuyển tiền&lt;br/&gt;(Ví gửi A, Ví nhận B, Số tiền, Idempotency-Key)\&quot;]) --&gt; CheckIdem{\&quot;Idempotency-Key đã&lt;br/&gt;tồn tại chưa?\&quot;}\n    \n    CheckIdem -- \&quot;Yes (Trùng lệnh)\&quot; --&gt; GetOld[\&quot;Lấy kết quả giao dịch cũ\&quot;]\n    GetOld --&gt; EndDup([\&quot;Kết thúc: Trả về 200 OK&lt;br/&gt;(Không trừ tiền lần 2)\&quot;])\n    \n    CheckIdem -- \&quot;No (Lệnh mới)\&quot; --&gt; LockRows[\&quot;Bật BEGIN TRAN &amp; Khóa dòng ví A, B&lt;br/&gt;(UPDLOCK, ROWLOCK)\&quot;]\n    LockRows --&gt; CheckRule{\&quot;Ví A ≠ Ví B VÀ Tiền &gt; 0&lt;br/&gt;VÀ Số dư A &gt;= Tiền chuyển?\&quot;}\n    \n    CheckRule -- \&quot;No (Vi phạm)\&quot; --&gt; Rollback[\&quot;Hủy giao dịch (ROLLBACK)\&quot;]\n    Rollback --&gt; EndErr([\&quot;Kết thúc: Báo lỗi 400&lt;br/&gt;(Số dư không đủ / Sai thông tin)\&quot;])\n    \n    CheckRule -- \&quot;Yes (Hợp lệ)\&quot; --&gt; InsertTx[\&quot;1. INSERT bảng TRANSACTIONS (COMPLETED)&lt;br/&gt;2. INSERT 2 dòng DEBIT/CREDIT vào LEDGER_ENTRIES\&quot;]\n    InsertTx --&gt; UpdateWallet[\&quot;3. UPDATE số dư mới vào WALLETS&lt;br/&gt;4. Chốt sổ (COMMIT TRAN)\&quot;]\n    UpdateWallet --&gt; EndOK([\&quot;Kết thúc: Trả về 200 OK&lt;br/&gt;(Chuyển tiền thành công)\&quot;])&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="e2G_Sp8Q64pYUFi7nHFz-1">
